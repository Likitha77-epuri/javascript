"use strict";

process.stdin.resume();
process.stdin.setEncoding("utf-8");

let inputString = "";
let currentLine = 0;

process.stdin.on("data", (inputStdin) => {
  inputString += inputStdin;
});

process.stdin.on("end", (_) => {
  inputString = inputString.trim().split("\n").map((str) => str.trim());
  main();
});

function readLine() {
  return inputString[currentLine++];
}

/* Please do not modify anything above this line */

function main() {
  const isSticksFound = JSON.parse(readLine());
  const isLighterFound = JSON.parse(readLine());

  /* Write your code here */
  try{
      if(!isSticksFound){
          throw new Error("Sticks Not Found");
      }
      console.log("Sticks Gathered");
      console.log("Sticks Arranged");
      
      if(!isLighterFound){
          throw new Error("Lighter Not Found");
      }
      console.log("Campfire Lighted");
  } catch(error){
      console.log(error.message);
  }
}
