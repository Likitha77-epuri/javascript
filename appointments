import {Component} from 'react'

import {v4 as uuidv4} from 'uuid'

import AppointmentItem from '../AppointmentItem'

import './index.css'

class Appointments extends Component {
  state = {
    titleInput: '',
    dateInput: '',
    appointmentsList: [],
    isFilterActive: false,
  }

  onChangeTitle = event => {
    this.setState({titleInput: event.target.value})
  }

  onChangeDate = event => {
    this.setState({dateInput: event.target.value})
  }

  onAddAppointment = event => {
    event.preventDefault()

    const {titleInput, dateInput} = this.state

    if (titleInput.trim() !== '' && dateInput !== '') {
      const newAppointment = {
        id: uuidv4(),
        title: titleInput.trim(),
        date: dateInput,
        isStarred: false,
      }

      this.setState(prevState => ({
        appointmentsList: [
          ...prevState.appointmentsList,
          newAppointment,
        ],
        titleInput: '',
        dateInput: '',
      }))
    }
  }

  onToggleStar = id => {
    this.setState(prevState => ({
      appointmentsList: prevState.appointmentsList.map(appointment => {
        if (appointment.id === id) {
          return {...appointment, isStarred: !appointment.isStarred}
        }
        return appointment
      }),
    }))
  }

  onToggleFilter = () => {
    this.setState(prevState => ({
      isFilterActive: !prevState.isFilterActive,
    }))
  }

  getFilteredAppointments = () => {
    const {appointmentsList, isFilterActive} = this.state

    if (isFilterActive) {
      return appointmentsList.filter(
        appointment => appointment.isStarred,
      )
    }

    return appointmentsList
  }

  render() {
    const {titleInput, dateInput, isFilterActive} = this.state
    const filteredAppointments = this.getFilteredAppointments()

    return (
      <div className="appointments-app-container">
        <div className="appointments-content">
          <div className="appointments-top-section">
            <div className="appointment-form-container">
              <h1 className="main-heading">Add Appointment</h1>

              <form onSubmit={this.onAddAppointment}>
                <label htmlFor="title" className="input-label">
                  TITLE
                </label>
                <input
                  id="title"
                  type="text"
                  className="title-input"
                  placeholder="Title"
                  value={titleInput}
                  onChange={this.onChangeTitle}
                />

                <label htmlFor="date" className="input-label">
                  DATE
                </label>
                <input
                  id="date"
                  type="date"
                  className="date-input"
                  value={dateInput}
                  onChange={this.onChangeDate}
                />

                <button type="submit" className="add-button">
                  Add
                </button>
              </form>
            </div>

            <img
              src="https://assets.ccbp.in/frontend/react-js/appointments-app/appointments-img.png"
              alt="appointments"
              className="appointments-image"
            />
          </div>

          <hr className="separator" />

          <div className="appointments-list-header">
            <h1 className="appointments-heading">Appointments</h1>
            <button
              type="button"
              className={`starred-filter-button ${
                isFilterActive ? 'active' : ''
              }`}
              onClick={this.onToggleFilter}
            >
              Starred
            </button>
          </div>

          <ul className="appointments-list">
            {filteredAppointments.map(appointment => (
              <AppointmentItem
                key={appointment.id}
                appointmentDetails={appointment}
                onToggleStar={this.onToggleStar}
              />
            ))}
          </ul>
        </div>
      </div>
    )
  }
}

export default Appointments
