"use strict";

process.stdin.resume();
process.stdin.setEncoding("utf-8");

let inputString = "";
let currentLine = 0;

process.stdin.on("data", (inputStdin) => {
  inputString += inputStdin;
});

process.stdin.on("end", (_) => {
  inputString = inputString.trim().split("\n").map((str) => str.trim());
  main();
});

function readLine() {
  return inputString[currentLine++];
}

/* Please do not modify anything above this line */

function main() {
  const isGrassTrimmerFound = JSON.parse(readLine());
  const isWaterHosePipeFound = JSON.parse(readLine());

  /* Write your code here */
  function trimGrass(){
      return new Promise((resolve,reject)=>{
          if(isGrassTrimmerFound){
              console.log("Grass Trimmed");
              console.log("Garden Cleaned");
              resolve();
          } else{
              reject("Grass Trimmer Not Found");
          }
      });
  }
  
  function waterPlants(){
      return new Promise((resolve,reject)=>{
          if(isWaterHosePipeFound){
              console.log("Watered Plants");
              resolve();
          } else{
              reject("Water Hose Pipe Not Found");
          }
      });
  }

  const myPromise = async () => {
    try {
     
      /* Write your code here */
      await trimGrass();
      await waterPlants();
      
    } catch(error) {

      /* Write your code here */
      console.log(error);
      
    }
  };
  
  myPromise();
}
