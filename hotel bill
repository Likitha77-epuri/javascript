"use strict";

process.stdin.resume();
process.stdin.setEncoding("utf-8");

let inputString = "";
let currentLine = 0;

process.stdin.on("data", (inputStdin) => {
  inputString += inputStdin;
});

process.stdin.on("end", (_) => {
  inputString = inputString.trim().split("\n").map((str) => str.trim());
  main();
});

function readLine() {
  return inputString[currentLine++];
}

/* Please do not modify anything above this line */

function main() {
  const dayCharge = JSON.parse(readLine());
  const days = parseInt(readLine());
 
  /* Write your code here */
  function calculateBill(dayCharge,days,discount=0){
      
      
      if(days<=2){
          discount=0;
      }else if(days<=5){
          discount=5;
      }else{
          discount=15;
      }
      const bill=dayCharge*days;
      return bill-(bill*discount)/100;
  }
  console.log(calculateBill(dayCharge,days));
}
